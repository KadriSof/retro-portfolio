
---
import Layout from "../components/layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import CareerTimeline from "../components/sections/CareerTimeline.astro";
import RetroWindow from "../components/ui/RetroWindow.astro";
import StatusIndicator from "../components/ui/StatusIndicator.astro";
import ProjectArchive from "../components/sections/ProjectArchive.astro";
import CharacterSheet from "../components/sections/CharacterSheet.astro";
import TechnicalInventory from "../components/sections/TechnicalInventory.astro";
import Contact from "../components/sections/Contact.astro";
---

<Layout>
  <Hero />

  <About />

  <CareerTimeline />

  <ProjectArchive />

  <section class="content-section" id="skills">
