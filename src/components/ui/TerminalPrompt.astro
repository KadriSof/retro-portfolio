---
interface Props {
  command: string;
  output?: string;
  user?: string;
  directory?: string;
}

const {
  command,
  output,
  user = "operator",
  directory = "~",
  } = Astro.props;

const lines = output === undefined
  ? []
  : Array.isArray(output) ? output : [output];
---

<div class="terminal" aria-label={`Terminal command: ${command}`}>
  <p class="terminal-line">
    <span class="terminal-prompt">{user}@portfolio</span>
    <span class="muted">:</span>
    <span class="accent">{directory}</span>
    <span class="terminal-prompt">$</span>
    <span class="terminal-command">{command}</span>
  </p>

  {lines.map((line) => (
    <p class="terminal-line terminal-output" aria-hidden="true">{line}</p>
  ))}
</div>
