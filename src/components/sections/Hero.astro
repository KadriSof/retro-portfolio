

---
import RetroWindow from "../ui/RetroWindow.astro";
import TerminalPrompt from "../ui/TerminalPrompt.astro";
import StatusIndicator from "../ui/StatusIndicator.astro";
---

<section class="hero" id="home">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">PERSONAL ENGINEERING ARCHIVE // VERSION 1.0</p>

      <h1>
        Building systems.
        <span>Engineering intelligence.</span>
      </h1>

      <p class="hero-description">
        A software craftsman and a data wizard.
        <br />
        I build systems that transform complex data into useful intelligence.
        Working across software engineering, data platforms, machine learning, and computer vision.
        Interested in the systems that connect computation, information, and the physical world.
      </p>

      <div class="hero-actions">
        <a class="pixel-button" href="#projects">
          Explore projects
        </a>

        <a class="pixel-button pixel-button--secondary" href="#contact">
          Establish contact
        </a>
      </div>

      <div class="hero-meta">
        <StatusIndicator label="Portfolio system online" />
        <span class="eyebrow">MODE: ENGINEERING</span>
      </div>
    </div>

    <div class="hero-card">
      <RetroWindow title="SYSTEM / OPERATOR PROFILE">
        <figure class="hero-portrait">
          <img
              src="/images/profile/ascii-art-pic.png"
            alt="Pixel-art portrait of SOF"
            width="588"
            height="495"
            loading="eager"
          />
          <figcaption>OPERATOR: SOF // LV.99</figcaption>
        </figure>

        <div class="hero-card-row">
          <span>IDENTIFIER</span>
          <span>SOF</span>
        </div>

        <div class="hero-card-row">
          <span>CLASS</span>
          <span>SOFTWARE ENGINEER</span>
        </div>

        <div class="hero-card-row">
          <span>PRIMARY DOMAIN</span>
          <span>SOFTWARE / DATA</span>
        </div>

        <div class="hero-card-row">
          <span>BACKGROUND</span>
          <span>ELECTRICAL ENGINEERING</span>
        </div>

        <TerminalPrompt
          command="init_portfolio"
          output={[
            "Loading operator profile...",
            "Initialization complete 🗹",
          ]}
        />
      </RetroWindow>
    </div>
  </div>
</section>
